# ── Back-end (Spring Boot) ──────────────────────────────────
# H2 in-memory (TP1 — sem credenciais reais)
DB_URL=jdbc:h2:mem:infnethubdb
DB_USER=sa
DB_PASS=

# Para TP2+: substituir pelo banco real (PostgreSQL, MySQL, etc.)
# DB_URL=jdbc:postgresql://localhost:5432/infnethub
# DB_USER=postgres
# DB_PASS=sua_senha_aqui

# ── Front-end (Next.js) ─────────────────────────────────────
# Copiado em frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
